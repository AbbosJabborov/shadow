# ==============================================================================
# Shadow Platform - Production Environment Configuration
# ==============================================================================

# --- Django Configuration ---
DEBUG=False
DJANGO_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_HOSTS=api-shadow.claive.uz,shadow.claive.uz,localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=https://shadow.claive.uz,http://shadow.claive.uz,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://shadow.claive.uz,https://api-shadow.claive.uz,http://shadow.claive.uz,http://api-shadow.claive.uz

# --- PostgreSQL Database ---
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Google Gemini AI ---
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
